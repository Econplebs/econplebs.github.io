---
// Esquema germinal «de lo abstracto a lo concreto».
// Al entrar en pantalla, el punto rojo aparece y las líneas se dibujan hacia la red de casos (menos de 1 s).
import { t, type Lang } from "../lib/sitio";

interface Props { lang: Lang; grande?: boolean }
const { lang, grande = false } = Astro.props;

// [x1, y1, x2, y2, retraso en ms]
const ramas = [
  [150, 46, 196, 22, 420], [150, 46, 214, 58, 450], [150, 46, 176, 86, 480],
  [196, 22, 238, 14, 640], [214, 58, 244, 40, 660], [214, 58, 236, 96, 690], [176, 86, 214, 112, 710],
];
// [x, y, radio, retraso en ms]
const nodos = [
  [196, 22, 5, 560], [214, 58, 5, 590], [176, 86, 5, 620],
  [238, 14, 4, 780], [244, 40, 4, 800], [236, 96, 4, 830], [214, 112, 4, 850],
];
---

<figure class:list={["esquema", { "esquema--grande": grande }]} data-esquema>
  <svg viewBox="0 0 260 150" role="img" aria-label={`${t("abstracto", lang)} → ${t("concreto", lang)}`}>
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path class="esquema__tronco" d="M34 118 L150 46" stroke-width="4" pathLength="1" />
      {ramas.map(([x1, y1, x2, y2, r]) => (
        <path class="esquema__rama" d={`M${x1} ${y1} L${x2} ${y2}`} pathLength="1" style={`--r:${r}ms`} />
      ))}
      {nodos.map(([x, y, rad, r]) => (
        <circle class="esquema__nodo" cx={x} cy={y} r={rad} style={`--r:${r}ms`} />
      ))}
    </g>
    <circle class="esquema__germen" cx="34" cy="118" r="11" />
  </svg>
  <figcaption class="rotulo rotulo--gris" aria-hidden="true">
    <span>{t("abstracto", lang)}</span><span>{t("concreto", lang)}</span>
  </figcaption>
</figure>

<script>
  const esquemas = document.querySelectorAll<HTMLElement>("[data-esquema]");
  const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reducido || !("IntersectionObserver" in window)) {
    esquemas.forEach((e) => e.classList.add("visto"));
  } else {
    const obs = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add("visto");
            obs.unobserve(en.target);
          }
        }),
      { threshold: 0.5 },
    );
    esquemas.forEach((e) => obs.observe(e));
  }
</script>

<style>
  .esquema { margin: 0; color: var(--grafito); width: 100%; max-width: 240px; }
  .esquema--grande { max-width: none; }
  .esquema svg { width: 100%; height: auto; overflow: visible; }
  .esquema__nodo { fill: var(--blanco); }
  .esquema__germen { fill: var(--rojo); }
  .esquema figcaption {
    display: flex; justify-content: space-between;
    margin-top: 0.9rem;
    font-size: 0.66rem;
  }

  /* Estado inicial (solo con JavaScript y sin «reducir movimiento») */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .esquema__germen {
      transform-origin: 34px 118px;
      transform: scale(0);
      transition: transform 0.28s cubic-bezier(0.3, 1.6, 0.5, 1);
    }
    :global(.js) .esquema__tronco,
    :global(.js) .esquema__rama {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    :global(.js) .esquema__tronco { transition: stroke-dashoffset 0.32s ease-out 0.14s; }
    :global(.js) .esquema__rama { transition: stroke-dashoffset 0.18s ease-out var(--r); }
    :global(.js) .esquema__nodo {
      transform-box: fill-box;
      transform-origin: center;
      transform: scale(0);
      transition: transform 0.16s ease-out var(--r);
    }
    .visto .esquema__germen,
    .visto .esquema__nodo { transform: scale(1) !important; }
    .visto .esquema__tronco,
    .visto .esquema__rama { stroke-dashoffset: 0 !important; }
  }
</style>
