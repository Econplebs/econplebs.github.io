---
// Barra lateral de la portada: Quién escribe, Por temas, Seguir las novedades y Agenda.
// La Agenda solo aparece si hay eventos futuros (de momento no hay ninguno).
import {
  t, ruta, rutaCategoria, rutaEtiqueta, nombreCategoria, recuentos, etiquetasDe, eventosFuturos, fecha, fechaISO,
  type Articulo, type Lang,
} from "../lib/sitio";

interface Props { lang: Lang; articulos: Articulo[] }
const { lang, articulos } = Astro.props;
const n = recuentos(articulos);
// La coyuntura es parte de la opinión; la didáctica va en Docencia
const temas = [
  { cat: "investigacion", n: n.investigacion, hija: false },
  { cat: "opinion", n: n.opinion, hija: false },
  { cat: "coyuntura", n: n.coyuntura, hija: true },
  { cat: "didactica", n: n.didactica, hija: false },
] as const;
const etiquetas = etiquetasDe(articulos);
const eventos = await eventosFuturos(lang);
---

<aside class="lateral">
  <section class="caja">
    <h2 class="caja__titulo">{t("quienEscribe", lang)}</h2>
    <p class="caja__texto">{t("quienEscribeTexto", lang)}</p>
    <a class="rotulo caja__enlace" href={ruta("sobreMi", lang)}>{t("masSobreMi", lang)}</a>
  </section>

  {articulos.length > 0 && <section class="caja">
    <h2 class="caja__titulo">{t("porTemas", lang)}</h2>
    <ul class="temas">
      {temas.filter((x) => x.n > 0).map((x) => (
        <li class:list={{ "temas--hija": x.hija }}>
          <a class="rotulo" href={rutaCategoria(x.cat, lang)}>
            {x.hija && <span aria-hidden="true" class="temas__flecha">↳</span>}
            <span>{nombreCategoria(x.cat, lang)}</span>
            <span class="temas__n">{x.n}</span>
          </a>
        </li>
      ))}
    </ul>
    {etiquetas.length > 0 && (
      <p class="etiquetas">
        {etiquetas.map((e) => <a href={rutaEtiqueta(e, lang)}>#{e}</a>)}
      </p>
    )}
  </section>}

  <section class="caja">
    <h2 class="caja__titulo">{t("seguirNovedades", lang)}</h2>
    <p class="caja__texto">{t("rssTexto", lang)}</p>
    <a class="boton rotulo caja__boton" href={ruta("rss", lang)}>
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><circle cx="3" cy="13" r="2" fill="currentColor" /><path d="M1.5 7.5a7 7 0 0 1 7 7M1.5 2.5a12 12 0 0 1 12 12" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      {t("rssBoton", lang)}
    </a>
  </section>

  {eventos.length > 0 && (
    <section class="caja">
      <h2 class="caja__titulo">{t("agenda", lang)}</h2>
      <ul class="agenda">
        {eventos.map((e) => (
          <li>
            <time class="rotulo rotulo--rojo" datetime={fechaISO(e.data.date)}>{fecha(e.data.date, lang)}</time>
            {e.data.link ? <a href={e.data.link}>{e.data.title}</a> : <span>{e.data.title}</span>}
            {e.data.place && <span class="agenda__lugar">{e.data.place}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}
</aside>

<style>
  .lateral { display: flex; flex-direction: column; gap: 0.75rem; }
  .caja {
    background: var(--blanco);
    border-top: 2px solid var(--grafito);
    padding: 1.4rem 1.35rem 1.5rem;
  }
  .caja__titulo { font-size: 1.2rem; margin-bottom: 0.9rem; }
  .caja__texto { font-size: 0.86rem; line-height: 1.6; }
  .caja__enlace { display: inline-block; margin-top: 0.8rem; text-decoration: none; font-size: 0.68rem; }
  .caja__enlace:hover { color: var(--rojo-texto); }
  .caja__boton { display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 1.1rem; font-size: 0.68rem; }

  .temas { list-style: none; margin: 0; padding: 0; }
  .temas li { border-bottom: 1px solid var(--filete); }
  .temas a {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.8rem 0;
    text-decoration: none;
    font-size: 0.68rem;
  }
  .temas a:hover { color: var(--rojo-texto); }
  .temas--hija a { padding-left: 1rem; }
  .temas__flecha { color: var(--gris); }
  .temas__n { margin-left: auto; color: var(--rojo-texto); font-size: 0.85rem; }
  .agenda { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; font-size: 0.9rem; }
  .agenda li { display: grid; gap: 0.2rem; }
  .agenda a { text-decoration-color: var(--rojo); }
  .agenda__lugar { color: var(--gris); font-size: 0.82rem; }
  .etiquetas { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .etiquetas a { font: 400 0.7rem var(--f-rotulo); letter-spacing: 0.04em; text-decoration: none; color: var(--gris); }
  .etiquetas a:hover { color: var(--rojo-texto); }
</style>
