---
import Base from "../layouts/Base.astro";
import imagenesBanco from "../datos/imagenes.json";
import Carrusel from "../components/Carrusel.astro";
import Lateral from "../components/Lateral.astro";
import {
  t, ruta, rutaArticulo, articulosDe, fecha, fechaISO, nombreCategoria, imagenDe, otro, hayPublicaciones,
  type Articulo, type Lang,
} from "../lib/sitio";

interface Props { lang: Lang }
const { lang } = Astro.props;
const conPublicaciones = await hayPublicaciones();
const todos = await articulosDe(lang);

// Carrusel: primero los destacados, luego avances de investigación, luego lo más reciente.
const orden = [
  ...todos.filter((a) => a.data.featured),
  ...todos.filter((a) => a.data.category === "investigacion" || a.data.category === "sindical"),
  ...todos,
];
const carrusel: Articulo[] = [...new Set(orden)].slice(0, 3);

// La lista no repite lo que ya sale en el carrusel.
const resto = todos.filter((a) => !carrusel.includes(a));
const [destacado, ...tarjetas] = resto;
---

<Base lang={lang} otraLengua={ruta("portada", otro(lang))} imagenes={carrusel.length ? carrusel.map(imagenDe) : imagenesBanco.images.filter((i) => i.key === "industria")}>
  <Carrusel lang={lang} articulos={carrusel} />

  <div class="envoltorio portada">
    <div class="portada__principal">
      <section class="franja" aria-labelledby="franja-titulo">
        <div class="franja__texto">
          <p class="rotulo rotulo--rojo">{t("investigacionDidactica", lang)}</p>
          <h2 id="franja-titulo">{t("queInvestigo", lang)}</h2>
          <p class="franja__entrada">{t("queInvestigoTexto", lang)}</p>
          <p class="franja__enlaces">
            <a class="rotulo enlace-subrayado" href={ruta("investigacion", lang)}>{t("lineasCorto", lang)}</a>
            <a class="rotulo enlace-subrayado" href={ruta("avances", lang)}>{t("economiaPolitica", lang)}</a>
            <a class="rotulo enlace-subrayado" href={ruta("sindical", lang)}>{t("cuadernoSindical", lang)}</a>
            {conPublicaciones && <a class="rotulo enlace-subrayado" href={ruta("publicaciones", lang)}>{t("publicaciones", lang)}</a>}
          </p>
        </div>
      </section>

      <section class="lecturas" aria-labelledby="lecturas-titulo">
        <p class="rotulo rotulo--rojo">{t("ultimasLecturas", lang)}</p>
        <h2 id="lecturas-titulo" class="lecturas__titulo">{t("nuevasIdeas", lang)}</h2>

        {!destacado && <p class="vacio">{t("sinArticulos", lang)}</p>}

        {destacado && (
          <article class="destacado">
            <p class="meta">
              <span class="rotulo rotulo--rojo">{nombreCategoria(destacado.data.category, lang)}</span>
              <time class="rotulo rotulo--gris" datetime={fechaISO(destacado.data.date)}>{fecha(destacado.data.date, lang)}</time>
            </p>
            <h3 class="destacado__titulo"><a href={rutaArticulo(destacado)}>{destacado.data.title}</a></h3>
            <p class="destacado__extracto">{destacado.data.excerpt}</p>
            <a class="boton rotulo destacado__boton" href={rutaArticulo(destacado)} aria-label={`${t("leer", lang)}: ${destacado.data.title}`}>{t("leer", lang)}</a>
          </article>
        )}

        {tarjetas.length > 0 && (
          <ul class="tarjetas">
            {tarjetas.slice(0, 3).map((a) => (
              <li class="tarjeta">
                <p class="rotulo rotulo--rojo">{nombreCategoria(a.data.category, lang)}</p>
                <h3 class="tarjeta__titulo"><a href={rutaArticulo(a)}>{a.data.title}</a></h3>
                <time class="rotulo rotulo--gris" datetime={fechaISO(a.data.date)}>{fecha(a.data.date, lang)}</time>
                <p class="tarjeta__extracto">{a.data.excerpt}</p>
                <a class="rotulo tarjeta__leer" href={rutaArticulo(a)} aria-label={`${t("leer", lang)}: ${a.data.title}`}>{t("leer", lang)}</a>
              </li>
            ))}
          </ul>
        )}

        {todos.length > 0 && <a class="rotulo archivo" href={ruta("articulos", lang)}>{t("archivoCompleto", lang)}</a>}
      </section>
    </div>

    <Lateral lang={lang} articulos={todos} />
  </div>
</Base>

<style>
  .portada {
    display: grid;
    grid-template-columns: minmax(0, 760px) 395px;
    gap: 30px;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    max-width: calc(1185px + 2 * var(--margen));
  }
  .portada__principal { min-width: 0; }

  .franja {
    background: var(--blanco);
    border-top: 3px solid var(--rojo);
    padding: 1.8rem 1.6rem 1.6rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }
  .franja h2 { font-size: 2rem; margin: 1.2rem 0 1.1rem; }
  .franja__entrada { font-size: 1.05rem; line-height: 1.55; }
  .franja__enlaces { display: flex; gap: 1.4rem; margin-top: 1.6rem; }

  .vacio { color: var(--gris); font-size: 1.15rem; margin-bottom: 1.5rem; }
  .lecturas { border-top: 1px solid var(--grafito); margin-top: 1.25rem; padding-top: 1.1rem; }
  .lecturas__titulo { font-size: 2.1rem; margin: 1.1rem 0 1.3rem; }

  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .destacado {
    background: var(--blanco);
    border-left: 6px solid var(--rojo);
    padding: 1.75rem 1.9rem 1.7rem;
  }
  .destacado__titulo { font-size: clamp(1.8rem, 2.9vw, 2.2rem); margin: 0.9rem 0 1rem; }
  .destacado__titulo a, .tarjeta__titulo a { text-decoration: none; }
  .destacado__titulo a:hover, .tarjeta__titulo a:hover { color: var(--rojo-texto); }
  .destacado__extracto { line-height: 1.5; }
  .destacado__boton { margin-top: 1rem; font-size: 0.68rem; }

  .tarjetas {
    list-style: none; margin: 4rem 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.3rem;
  }
  .tarjeta {
    background: var(--blanco);
    border-left: 3px solid var(--grafito);
    padding: 1.4rem 1.3rem 1.3rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .tarjeta__titulo { font-size: 1.3rem; line-height: 1.2; }
  .tarjeta__extracto { font-size: 0.92rem; line-height: 1.55; }
  .tarjeta__leer { text-decoration: none; margin-top: auto; }
  .tarjeta__leer:hover { color: var(--rojo-texto); }

  .archivo {
    display: block;
    border-top: 1px solid var(--grafito);
    margin-top: 1.3rem;
    padding-top: 1.1rem;
    text-decoration: none;
  }
  .archivo:hover { color: var(--rojo-texto); }

  @media (max-width: 999px) {
    .portada { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 759px) {
    .franja { grid-template-columns: minmax(0, 1fr); padding: 1.4rem 1.1rem; gap: 1.6rem; }
    .franja h2 { font-size: 1.65rem; }
    .franja__enlaces { flex-wrap: wrap; }
    .lecturas__titulo { font-size: 1.85rem; }
    .destacado { padding: 1.4rem 1.2rem; }
    .destacado__titulo { font-size: 1.75rem; }
    .tarjetas { grid-template-columns: minmax(0, 1fr); margin-top: 2.5rem; }
  }
</style>
