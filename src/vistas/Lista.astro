---
// Archivo de artículos (todos, una sección o una etiqueta), con la barra lateral.
import Base from "../layouts/Base.astro";
import Lateral from "../components/Lateral.astro";
import ListaArticulos from "../components/ListaArticulos.astro";
import { t, ruta, articulosDe, imagenDe, type Articulo, type Lang } from "../lib/sitio";

interface Props {
  lang: Lang;
  titulo: string;
  otraLengua: string;
  articulos: Articulo[];
  categoria?: boolean;
  imagenes?: boolean;
  vacio?: string;
  intro?: { rotulo: string; titulo: string; texto: string }; // cabecera grande (Opinión)
}
const { lang, titulo, otraLengua, articulos, categoria = true, imagenes = false, vacio, intro } = Astro.props;
const todos = await articulosDe(lang);
const H = intro ? "h2" : "h1";
---

<Base lang={lang} titulo={titulo} otraLengua={otraLengua} imagenes={imagenes ? articulos.map(imagenDe) : []}>
  {intro && (
    <header class="intro envoltorio">
      <p class="rotulo">{intro.rotulo}</p>
      <h1>{intro.titulo}</h1>
      <p class="intro__texto">{intro.texto}</p>
    </header>
  )}
  <div class="envoltorio archivo">
    <section class="archivo__principal">
      <div class="archivo__cabecera">
        <H class:list={["archivo__titulo", { "archivo__titulo--pequeno": intro }]}>{intro ? t("articulos", lang) : titulo}</H>
        <a class="rotulo" href={ruta("rss", lang)}>RSS</a>
      </div>
      <ListaArticulos lang={lang} articulos={articulos} categoria={categoria} imagenes={imagenes} vacio={vacio} />
    </section>
    <Lateral lang={lang} articulos={todos} />
  </div>
</Base>

<style>
  .intro { padding-top: 3rem; padding-bottom: 0.5rem; max-width: calc(760px + 2 * var(--margen)); }
  .intro h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: 1rem 0 1.1rem; }
  .intro__texto { font-size: 1.2rem; line-height: 1.55; }

  .archivo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 395px;
    gap: 3rem;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }
  .archivo__cabecera {
    display: flex; justify-content: space-between; align-items: flex-end;
    border-bottom: 2px solid var(--grafito);
    padding-bottom: 0.6rem;
  }
  .archivo__cabecera a { text-decoration: none; }
  .archivo__cabecera a:hover { color: var(--rojo); }
  .archivo__titulo { font-size: clamp(2rem, 4vw, 2.6rem); }
  .archivo__titulo--pequeno { font-size: 1.6rem; }

  @media (max-width: 999px) {
    .archivo { grid-template-columns: minmax(0, 1fr); }
  }
</style>
