---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { componentesDidactica } from "../components/didactica";
import {
  t, ruta, rutaArticulo, rutaCategoria, rutaEtiqueta, fecha, fechaISO, mostrarActualizado,
  minutosLectura, nombreCategoria, prepararCuerpo, traduccionDe, otro, type Articulo,
} from "../lib/sitio";
import { citaTexto, rutaCita, urlArticulo } from "../lib/citas";
import { SITIO } from "../configuracion.mjs";

interface Props { articulo: Articulo; anterior?: Articulo; siguiente?: Articulo; lista: Articulo[] }
const { articulo, anterior, siguiente, lista } = Astro.props;
const { data } = articulo;
const lang = data.lang;

// Los artículos .mdx pueden llevar componentes interactivos (src/components/didactica)
const esMdx = articulo.filePath?.endsWith(".mdx") ?? false;
const { Content, headings } = esMdx ? await render(articulo) : { Content: null, headings: [] };
const html = esMdx ? "" : prepararCuerpo(articulo.rendered?.html ?? "", lang);
const apartados = (esMdx ? headings : articulo.rendered?.metadata?.headings ?? []).filter((h) => h.depth === 2 && h.slug !== "footnote-label");
const conIndice = apartados.length >= 3;

const relacionados = lista.filter((a) => a !== articulo && a.data.category === data.category).slice(0, 3);

const traduccion = await traduccionDe(articulo);
const otraLengua = traduccion ? rutaArticulo(traduccion) : ruta("portada", otro(lang));

// Datos para Google Scholar, Zotero y buscadores (no se ven en la página)
const fechaScholar = fechaISO(data.date).replaceAll("-", "/");
const academico = data.category === "investigacion" || data.category === "didactica";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": academico ? "ScholarlyArticle" : "Article",
  headline: data.title,
  abstract: data.excerpt || undefined,
  datePublished: fechaISO(data.date),
  dateModified: fechaISO(data.updated ?? data.date),
  inLanguage: lang === "es" ? "es" : "ca",
  url: urlArticulo(articulo),
  author: { "@type": "Organization", name: "Econplebs", url: SITIO },
  publisher: { "@type": "Organization", name: "Econplebs", url: SITIO },
  license: "https://creativecommons.org/licenses/by-sa/4.0/",
  keywords: data.tags.length ? data.tags.join(", ") : undefined,
};
---

<Base lang={lang} titulo={data.title} descripcion={data.excerpt} otraLengua={otraLengua} tipo="article" tarjeta={`/tarjetas/${lang}-${data.slug}.jpg`}>
  <Fragment slot="head">
    <meta name="citation_title" content={data.title} />
    <meta name="citation_author" content="Econplebs" />
    <meta name="citation_publication_date" content={fechaScholar} />
    <meta name="citation_online_date" content={fechaScholar} />
    <meta name="citation_language" content={lang} />
    <meta name="citation_publisher" content="Econplebs" />
    <meta name="citation_fulltext_html_url" content={urlArticulo(articulo)} />
    {data.excerpt && <meta name="citation_abstract" content={data.excerpt} />}
    {data.tags.map((e) => <meta name="citation_keywords" content={e} />)}
    <meta name="DC.title" content={data.title} />
    <meta name="DC.creator" content="Econplebs" />
    <meta name="DC.date" content={fechaISO(data.date)} />
    <meta name="DC.language" content={lang} />
    <meta name="DC.rights" content="CC BY-SA 4.0" />
    <meta property="article:published_time" content={fechaISO(data.date)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div slot="arriba" class="progreso" aria-hidden="true"><span data-progreso></span></div>

  <article class:list={["articulo", { "articulo--con-indice": conIndice }]} data-articulo data-pagefind-body data-muestra={data.sample ? "" : undefined}>
    <header class="articulo__cabecera">
      <p class="solo-imprimir rotulo articulo__imprenta">Econplebs · {urlArticulo(articulo).replace(/^https:\/\//, "")}</p>
      <p class="rotulo articulo__ruta" data-pagefind-ignore>
        <a href={ruta("articulos", lang)}><span aria-hidden="true">← </span>{t("articulos", lang)}</a>
        <span aria-hidden="true">/</span>
        <a href={rutaCategoria(data.category, lang)}>{nombreCategoria(data.category, lang)}</a>
      </p>
      <p class="articulo__meta rotulo" data-pagefind-ignore>
        <a class="rotulo--rojo" href={rutaCategoria(data.category, lang)}>{nombreCategoria(data.category, lang)}</a>
        <time datetime={fechaISO(data.date)}>{fecha(data.date, lang)}</time>
        {mostrarActualizado(articulo) && (
          <span>{t("actualizado", lang)}: <time datetime={fechaISO(data.updated!)}>{fecha(data.updated!, lang)}</time></span>
        )}
        <span>{minutosLectura(articulo.body ?? html, lang)}</span>
      </p>
      <h1 class="articulo__titulo">{data.title}</h1>
      {data.excerpt && <p class="articulo__entradilla">{data.excerpt}</p>}
      <p class="rotulo rotulo--gris articulo__firma" data-pagefind-ignore>Econplebs</p>
    </header>

    {conIndice && (
      <nav class="indice" aria-labelledby="indice-titulo" data-pagefind-ignore>
        <p class="rotulo rotulo--gris" id="indice-titulo">{t("enEsteArticulo", lang)}</p>
        <ol>
          {apartados.map((h) => <li><a href={`#${h.slug}`} data-indice={h.slug}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    {esMdx && Content ? (
      <div class="cuerpo" data-cuerpo><Content components={componentesDidactica} /></div>
    ) : (
      <div class="cuerpo" set:html={html} data-cuerpo />
    )}

    <footer class="articulo__pie" data-pagefind-ignore>
      <p class="rotulo">{t("finArticulo", lang)}</p>
      {data.tags.length > 0 && (
        <p class="rotulo rotulo--rojo articulo__etiquetas">
          {t("etiquetas", lang)}:{" "}
          {data.tags.map((e) => <a href={rutaEtiqueta(e, lang)}>{e}</a>)}
        </p>
      )}
      <p class="articulo__licencia">{t("licenciaTexto", lang)}</p>

      <section class="citar" aria-labelledby="citar-titulo">
        <h2 id="citar-titulo" class="rotulo">{t("comoCitar", lang)}</h2>
        <p class="citar__texto" data-cita>{citaTexto(articulo)}</p>
        <p class="citar__acciones">
          <button class="rotulo" type="button" data-copiar-cita data-hecho={t("citaCopiada", lang)}>{t("copiarCita", lang)}</button>
          <a class="rotulo" href={rutaCita(articulo, "bib")} download>BibTeX</a>
          <a class="rotulo" href={rutaCita(articulo, "ris")} download>RIS (Zotero, Mendeley)</a>
          <button class="rotulo" type="button" data-imprimir>{t("imprimir", lang)}</button>
        </p>
      </section>

      {relacionados.length > 0 && (
        <section class="relacionados" aria-labelledby="relacionados-titulo">
          <h2 id="relacionados-titulo">{t("seguirLeyendo", lang)}</h2>
          <ul>
            {relacionados.map((a) => (
              <li>
                <a href={rutaArticulo(a)}>{a.data.title}</a>
                <time class="rotulo rotulo--gris" datetime={fechaISO(a.data.date)}>{fecha(a.data.date, lang)}</time>
              </li>
            ))}
          </ul>
        </section>
      )}

      <nav class="vecinos" aria-label={`${t("anteriorCorto", lang)} / ${t("siguienteCorto", lang)}`}>
        {anterior && (
          <a class="vecinos__anterior" href={rutaArticulo(anterior)} rel="prev">
            <span class="rotulo rotulo--gris"><span aria-hidden="true">← </span>{t("anteriorCorto", lang)}</span>
            {anterior.data.title}
          </a>
        )}
        {siguiente && (
          <a class="vecinos__siguiente" href={rutaArticulo(siguiente)} rel="next">
            <span class="rotulo rotulo--gris">{t("siguienteCorto", lang)}<span aria-hidden="true"> →</span></span>
            {siguiente.data.title}
          </a>
        )}
      </nav>
    </footer>
  </article>
</Base>

<script>
  // Lectura larga: barra de progreso, índice que sigue la lectura y notas al margen.
  const articulo = document.querySelector<HTMLElement>("[data-articulo]");
  const cuerpo = document.querySelector<HTMLElement>("[data-cuerpo]");
  const barra = document.querySelector<HTMLElement>("[data-progreso]");

  if (articulo && cuerpo) {
    // 1. Barra de progreso (se llena según lo leído del cuerpo del artículo)
    const pintarProgreso = () => {
      const r = cuerpo.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const hecho = Math.min(1, Math.max(0, (innerHeight * 0.4 - r.top) / Math.max(1, total)));
      if (barra) barra.style.transform = `scaleX(${hecho})`;
    };
    addEventListener("scroll", pintarProgreso, { passive: true });
    addEventListener("resize", pintarProgreso);
    pintarProgreso();

    // 2. Índice: marca el apartado que se está leyendo
    const enlaces = [...document.querySelectorAll<HTMLAnchorElement>("[data-indice]")];
    if (enlaces.length) {
      const titulos = enlaces
        .map((a) => document.getElementById(a.dataset.indice!))
        .filter((h): h is HTMLElement => !!h);
      const marcar = () => {
        let actual = titulos[0]?.id;
        for (const h of titulos) if (h.getBoundingClientRect().top < innerHeight * 0.35) actual = h.id;
        enlaces.forEach((a) =>
          a.dataset.indice === actual ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current"),
        );
      };
      addEventListener("scroll", marcar, { passive: true });
      marcar();
    }

    document.querySelector("[data-imprimir]")?.addEventListener("click", () => print());

    // Copiar la cita al portapapeles
    const copiar = document.querySelector<HTMLButtonElement>("[data-copiar-cita]");
    copiar?.addEventListener("click", async () => {
      const cita = document.querySelector<HTMLElement>("[data-cita]")!;
      let hecho = false;
      try {
        await navigator.clipboard.writeText(cita.textContent ?? "");
        hecho = true;
      } catch {
        // Método clásico: seleccionar el texto y copiarlo
        getSelection()?.selectAllChildren(cita);
        hecho = document.execCommand("copy");
        getSelection()?.removeAllRanges();
      }
      if (hecho) {
        const antes = copiar.textContent;
        copiar.textContent = copiar.dataset.hecho!;
        setTimeout(() => (copiar.textContent = antes), 2000);
      }
    });

    // 3. Notas al margen en pantallas anchas (en el móvil se quedan al final)
    const ancho = matchMedia("(min-width: 1180px)");
    const colocarNotas = () => {
      cuerpo.querySelectorAll(".nota-margen").forEach((n) => n.remove());
      articulo.classList.toggle("con-notas-margen", ancho.matches);
      if (!ancho.matches) return;
      let suelo = 0;
      const base = cuerpo.getBoundingClientRect().top;
      cuerpo.querySelectorAll<HTMLAnchorElement>("a[data-footnote-ref]").forEach((ref) => {
        const nota = document.getElementById(ref.getAttribute("href")!.slice(1));
        if (!nota) return;
        const aparte = document.createElement("aside");
        aparte.className = "nota-margen";
        aparte.setAttribute("aria-hidden", "true");
        const copia = nota.cloneNode(true) as HTMLElement;
        copia.querySelectorAll("[data-footnote-backref]").forEach((b) => b.remove());
        aparte.innerHTML = `<span class="nota-margen__n">${ref.textContent}</span>${copia.innerHTML}`;
        cuerpo.appendChild(aparte);
        const arriba = Math.max(ref.getBoundingClientRect().top - base - 4, suelo);
        aparte.style.top = `${arriba}px`;
        suelo = arriba + aparte.offsetHeight + 16;
      });
    };
    ancho.addEventListener("change", colocarNotas);
    let espera: number | undefined;
    addEventListener("resize", () => { clearTimeout(espera); espera = window.setTimeout(colocarNotas, 150); });
    colocarNotas();
    document.fonts?.ready.then(colocarNotas);
  }
</script>

<style>
  .progreso {
    position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 60;
    pointer-events: none;
  }
  .progreso span {
    display: block; height: 100%;
    background: var(--rojo);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .articulo {
    --col: min(760px, calc(100% - 2 * var(--margen)));
    display: grid;
    grid-template-columns: 1fr var(--col) 1fr;
    padding: 1.6rem 0 0;
  }
  .articulo > * { grid-column: 2; min-width: 0; }

  .articulo__ruta { display: flex; gap: 0.15rem; }
  .articulo__ruta a { text-decoration: none; }
  .articulo__ruta a:hover, .articulo__meta a:hover { color: var(--rojo-texto); }
  .articulo__meta {
    display: flex; flex-wrap: wrap; gap: 0.3rem 1.6rem;
    margin-top: 1.4rem;
    color: var(--gris);
  }
  .articulo__meta a { text-decoration: none; }
  .articulo__titulo { font-size: clamp(2.3rem, 5vw, 3.6rem); margin: 1.4rem 0 1.6rem; line-height: 1.08; }
  .articulo__entradilla {
    border-left: 3px solid var(--rojo);
    padding: 0.1rem 0 0.1rem 1.1rem;
    font-size: 1.2rem; line-height: 1.55;
  }
  .articulo__firma { margin: 1.5rem 0 1.9rem; }

  /* Índice */
  .indice {
    border-top: 1px solid var(--grafito);
    border-bottom: 1px solid var(--filete);
    padding: 1rem 0 1.1rem;
    margin-bottom: 2rem;
  }
  .indice ol { list-style: none; margin: 0.7rem 0 0; padding: 0; display: grid; gap: 0.4rem; }
  .indice a {
    display: block;
    text-decoration: none;
    font: 500 0.92rem/1.35 var(--f-interfaz);
    color: var(--gris);
    border-left: 2px solid transparent;
    padding-left: 0.7rem;
    margin-left: -0.7rem;
  }
  .indice a:hover { color: var(--grafito); }
  .indice a[aria-current="true"] { color: var(--grafito); border-left-color: var(--rojo); }

  /* Cuerpo */
  .cuerpo { position: relative; }
  .cuerpo :global(p),
  .cuerpo :global(ul),
  .cuerpo :global(ol) { max-width: 68ch; line-height: 1.75; margin: 0 0 1.3rem; font-size: 1.08rem; }
  .cuerpo :global(h2) { font-size: 1.75rem; margin: 2.6rem 0 1.2rem; scroll-margin-top: 1.5rem; }
  .cuerpo :global(h3) { font-size: 1.3rem; margin: 2rem 0 0.9rem; }
  .cuerpo :global(a) { text-decoration-color: var(--rojo); text-underline-offset: 0.18em; }
  .cuerpo :global(code) { font-family: var(--f-codigo); font-size: 0.88em; }
  .cuerpo :global(sup) { line-height: 0; }
  .cuerpo :global(sup a) { text-decoration: none; color: var(--rojo-texto); font: 600 0.75rem var(--f-rotulo); padding: 0 0.1rem; }

  .cuerpo :global(blockquote) {
    margin: 1.8rem 0; padding-left: 1.2rem;
    border-left: 2px solid var(--filete);
  }
  .cuerpo :global(.cita-destacada) {
    border: 0;
    margin: 2.6rem 0;
    padding: 1.4rem 0 0;
    position: relative;
    max-width: 34rem;
  }
  .cuerpo :global(.cita-destacada)::before {
    content: ""; position: absolute; top: 0; left: 0;
    width: 3.5rem; height: 3px; background: var(--rojo);
  }
  .cuerpo :global(.cita-destacada p) {
    font: italic 400 clamp(1.4rem, 2.5vw, 1.75rem)/1.35 var(--f-lectura);
    margin: 0;
  }

  /* Notas al pie (móvil y pantallas medianas) */
  .cuerpo :global(.footnotes) {
    border-top: 1px solid var(--filete);
    margin-top: 2.4rem; padding-top: 0.6rem;
    font-size: 0.9rem;
  }
  .cuerpo :global(.footnotes h2) { font-size: 0 !important; }
  .cuerpo :global(.footnotes h2)::before { content: "Notas"; font-size: 0.72rem; }
  :global(:lang(ca)) .cuerpo :global(.footnotes h2)::before { content: "Notes"; }
  .cuerpo :global(.footnotes h2) {
    position: static !important; width: auto !important; height: auto !important;
    clip: auto !important; margin: 0.6rem 0 0.8rem; overflow: visible !important; white-space: normal !important;
    font: 600 0.72rem var(--f-rotulo); letter-spacing: 0.1em; text-transform: uppercase; color: var(--gris);
  }
  .cuerpo :global(.footnotes ol) { padding-left: 1.2rem; }
  .cuerpo :global(.footnotes li p) { font-size: 0.9rem; line-height: 1.55; margin-bottom: 0.6rem; }
  .cuerpo :global(.footnotes li::marker) { color: var(--rojo-texto); font-family: var(--f-rotulo); font-weight: 600; }
  .cuerpo :global([data-footnote-backref]) { text-decoration: none; color: var(--rojo-texto); }

  /* Notas al margen (pantallas anchas) */
  .cuerpo :global(.nota-margen) {
    position: absolute;
    left: 44.5rem;
    width: 200px;
    font-size: 0.82rem; line-height: 1.5;
    color: var(--gris);
    border-top: 1px solid var(--filete);
    padding-top: 0.45rem;
  }
  .cuerpo :global(.nota-margen p) { font-size: inherit; line-height: inherit; margin: 0; max-width: none; }
  .cuerpo :global(.nota-margen__n) { color: var(--rojo-texto); font: 600 0.72rem var(--f-rotulo); margin-right: 0.35rem; }
  :global(.con-notas-margen) .cuerpo :global(.footnotes) {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0);
  }

  @media (min-width: 1180px) {
    .articulo--con-indice .indice {
      grid-column: 1;
      grid-row: 2 / span 1;
      align-self: start;
      position: sticky; top: 2rem;
      justify-self: end;
      width: 190px;
      margin: 0.4rem 2.5rem 0 0;
      border-bottom: 0;
      padding-top: 0.8rem;
    }
    .articulo--con-indice .cuerpo { grid-row: 2; }
    .articulo__cabecera { grid-row: 1; }
  }

  /* Pie del artículo */
  .articulo__pie { border-top: 1px solid var(--grafito); margin-top: 1.4rem; padding-top: 1.1rem; }
  .articulo__etiquetas { margin-top: 1.4rem; display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .articulo__etiquetas a { text-decoration: none; }
  .articulo__etiquetas a:hover { text-decoration: underline; }
  .articulo__licencia { font-size: 0.85rem; margin-top: 1.4rem; }
  /* Cómo citar */
  .citar {
    background: var(--blanco);
    border-left: 3px solid var(--grafito);
    padding: 1.1rem 1.3rem 1.2rem;
    margin-top: 1.4rem;
  }
  .citar h2 { font: 500 0.72rem var(--f-rotulo); letter-spacing: 0.14em; margin-bottom: 0.7rem; }
  .citar__texto { font-size: 0.95rem; line-height: 1.6; overflow-wrap: anywhere; user-select: all; }
  .citar__acciones { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .citar__acciones button, .citar__acciones a {
    padding: 0.5rem 0.8rem;
    background: none; color: var(--grafito); border: 1px solid var(--grafito); cursor: pointer;
    text-decoration: none; font-size: 0.66rem;
  }
  .citar__acciones button:hover, .citar__acciones a:hover { color: var(--rojo-texto); border-color: var(--rojo); }
  .articulo__imprenta { margin-bottom: 1.2rem; }
  @media print {
    .articulo { display: block; padding: 0; }
    .articulo__titulo { font-size: 24pt; }
    .articulo__entradilla { font-size: 13pt; }
    .cuerpo :global(p), .cuerpo :global(li) { font-size: 11pt; line-height: 1.55; max-width: none; }
    .cuerpo :global(h2) { font-size: 15pt; }
    .cuerpo :global(.footnotes) { position: static !important; width: auto !important; height: auto !important; overflow: visible !important; clip: auto !important; }
  }

  .relacionados { border-top: 1px solid var(--grafito); margin-top: 1.9rem; padding-top: 1.1rem; }
  .relacionados h2 { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.6rem; }
  .relacionados ul { list-style: none; margin: 0; padding: 0; }
  .relacionados li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    border-bottom: 1px solid var(--filete);
    padding: 1rem 0 0.75rem;
  }
  .relacionados li a { font-size: 1.2rem; text-decoration: none; }
  .relacionados li a:hover { color: var(--rojo-texto); }
  .relacionados time { flex: none; text-transform: none; letter-spacing: 0.04em; }

  .vecinos {
    border-top: 1px solid var(--grafito);
    margin-top: 1.25rem;
    padding: 1.1rem 0 2.5rem;
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
  }
  .vecinos a { display: grid; gap: 0.35rem; text-decoration: none; font-size: 0.95rem; }
  .vecinos a:hover { color: var(--rojo-texto); }
  .vecinos__siguiente { grid-column: 2; text-align: right; }

  @media (max-width: 759px) {
    .articulo__meta { gap: 0.3rem 1rem; }
    .relacionados li { flex-direction: column; gap: 0.4rem; }
    .vecinos { grid-template-columns: 1fr; }
    .vecinos__siguiente { grid-column: 1; }
  }
</style>
