---
// Materiales: biblioteca de recursos descargables con buscador y filtros (área y formato).
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { t, ruta, otro, type Lang } from "../lib/sitio";

interface Props { lang: Lang; pagina?: CollectionEntry<"paginas"> }
const { lang, pagina } = Astro.props;
const titulo = pagina?.data.title ?? t("datosYMateriales", lang);

const hayArchivos = Object.keys(import.meta.glob("/contenido/recursos/[!_]*.md")).length > 0;
const recursos = (hayArchivos ? await getCollection("recursos", (r) => !r.data.lang || r.data.lang === lang) : [])
  .sort((a, b) => a.data.title.localeCompare(b.data.title, lang));
const formato = (archivo: string) =>
  /\.(xlsx?|ods|csv|json|tsv)$/i.test(archivo) ? "datos" : "documento";
const nombreArea = { investigacion: t("investigacion", lang), docencia: t("didactica", lang), general: t("general", lang) };
---

<Base lang={lang} titulo={titulo} otraLengua={ruta("recursos", otro(lang))}>
  <header class="intro">
    <p class="rotulo">{t("bibliotecaAbierta", lang)}</p>
    <h1>{titulo}</h1>
    <p class="intro__texto">{t("recursosLead", lang)}</p>
  </header>

  <div class="biblioteca">
    {recursos.length === 0 ? (
      <p class="vacio">{t("sinRecursos", lang)}</p>
    ) : (
      <>
        <form class="filtros" role="search" aria-label={t("filtrarRecursos", lang)} data-filtros>
          <label>
            <span class="rotulo">{t("buscarRecursos", lang)}</span>
            <input type="search" name="q" placeholder={t("tituloPalabra", lang)} />
          </label>
          <label>
            <span class="rotulo">{t("areaRecurso", lang)}</span>
            <select name="area">
              <option value="">{t("todasAreas", lang)}</option>
              <option value="investigacion">{nombreArea.investigacion}</option>
              <option value="docencia">{nombreArea.docencia}</option>
              <option value="general">{nombreArea.general}</option>
            </select>
          </label>
          <fieldset>
            <legend class="rotulo">{t("filtrarRecursos", lang)}</legend>
            <label><input type="radio" name="formato" value="" checked /> {t("todos", lang)}</label>
            <label><input type="radio" name="formato" value="documento" /> {t("documentos", lang)}</label>
            <label><input type="radio" name="formato" value="datos" /> {t("hojasDatos", lang)}</label>
          </fieldset>
        </form>
        <ul class="recursos" data-recursos>
          {recursos.map((r) => (
            <li class="recurso" data-area={r.data.area} data-formato={formato(r.data.file)}
                data-texto={`${r.data.title} ${r.data.description}`.toLowerCase()}>
              <p class="rotulo rotulo--rojo">
                {nombreArea[r.data.area]} · {t(formato(r.data.file) === "datos" ? "datos" : "documento", lang)}
              </p>
              <h2>{r.data.title}</h2>
              {r.data.description && <p class="recurso__texto">{r.data.description}</p>}
              <p class="recurso__meta">
                {r.data.version && <span>{t("version", lang)} {r.data.version}</span>}
                <span>{r.data.license}</span>
                {r.data.source && <a href={r.data.source}>{t("fuente", lang)}</a>}
              </p>
              <a class="boton rotulo" href={r.data.file} download>{t("descargar", lang)}</a>
            </li>
          ))}
        </ul>
        <p class="vacio" hidden data-sin-coincidencias>{t("noCoinciden", lang)}</p>
      </>
    )}
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-filtros]");
  if (form) {
    const filas = [...document.querySelectorAll<HTMLElement>("[data-recursos] > li")];
    const aviso = document.querySelector<HTMLElement>("[data-sin-coincidencias]");
    const area = new URLSearchParams(location.search).get("area");
    if (area) (form.elements.namedItem("area") as HTMLSelectElement).value = area;
    const filtrar = () => {
      const datos = new FormData(form);
      const q = String(datos.get("q") ?? "").trim().toLowerCase();
      const a = String(datos.get("area") ?? "");
      const f = String(datos.get("formato") ?? "");
      let visibles = 0;
      filas.forEach((li) => {
        const ok = (!q || li.dataset.texto!.includes(q)) && (!a || li.dataset.area === a) && (!f || li.dataset.formato === f);
        li.hidden = !ok;
        if (ok) visibles++;
      });
      if (aviso) aviso.hidden = visibles > 0;
    };
    form.addEventListener("input", filtrar);
    form.addEventListener("submit", (e) => { e.preventDefault(); filtrar(); });
    filtrar();
  }
</script>

<style>
  .intro, .biblioteca {
    max-width: calc(1120px + 2 * var(--margen));
    margin: 0 auto;
    padding: 0 var(--margen);
  }
  .intro { padding-top: 1.9rem; padding-bottom: 1.6rem; border-bottom: 1px solid var(--grafito); }
  .intro h1 { font-size: clamp(2.1rem, 4vw, 2.6rem); margin: 1.1rem 0; }
  .intro__texto { font-size: 1.2rem; line-height: 1.6; max-width: 46rem; }
  .biblioteca { padding-top: 1.6rem; padding-bottom: 3rem; }
  .vacio { color: var(--gris); font-size: 1.15rem; }

  .filtros { display: flex; flex-wrap: wrap; gap: 1.2rem 2rem; align-items: end; margin-bottom: 1.6rem; }
  .filtros label { display: grid; gap: 0.4rem; }
  .filtros input[type="search"], .filtros select {
    font: 400 1rem var(--f-lectura);
    border: 1px solid var(--grafito); background: var(--blanco);
    padding: 0.55rem 0.7rem; min-width: 14rem;
  }
  .filtros fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .filtros fieldset label { display: flex; gap: 0.35rem; align-items: center; font-size: 0.92rem; }
  .filtros legend { margin-bottom: 0.4rem; }
  .filtros input[type="radio"] { accent-color: var(--rojo); }

  .recursos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.2rem; }
  .recurso {
    background: var(--blanco);
    border-top: 2px solid var(--grafito);
    padding: 1.3rem;
    display: flex; flex-direction: column; gap: 0.7rem;
  }
  .recurso h2 { font-size: 1.3rem; }
  .recurso__texto { font-size: 0.92rem; line-height: 1.55; }
  .recurso__meta { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.82rem; color: var(--gris); }
  .recurso .boton { align-self: start; margin-top: auto; }
</style>
