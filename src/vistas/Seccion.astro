---
// Página de Investigación: texto fijo de plantilla + el cuerpo de la página (Markdown),
// las dos líneas (economía política y didáctica de la economía) y una caja con los enlaces de la sección.
import type { CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import ListaArticulos from "../components/ListaArticulos.astro";
import { t, ruta, otro, articulosDe, hayPublicaciones, prepararCuerpo, type Lang } from "../lib/sitio";

interface Props { lang: Lang; pagina?: CollectionEntry<"paginas"> }
const { lang, pagina } = Astro.props;
const conPublicaciones = await hayPublicaciones();
const todos = await articulosDe(lang);
const lineas = [
  { id: "avances", titulo: t("economiaPolitica", lang), lista: todos.filter((a) => a.data.category === "investigacion"),
    vacio: t("sinAvances", lang), mas: `${t("economiaPolitica", lang)} →`, href: ruta("avances", lang) },
  { id: "didactica", titulo: t("didactica", lang), lista: todos.filter((a) => a.data.category === "didactica"),
    vacio: t("sinDidactica", lang), mas: `${t("didactica", lang)} →`, href: ruta("didactica", lang) },
];
const cuerpo = prepararCuerpo(pagina?.rendered?.html ?? "", lang);
const titulo = pagina?.data.title ?? t("investigacion", lang);
---

<Base lang={lang} titulo={titulo} otraLengua={ruta("investigacion", otro(lang))}>
  <header class="intro">
    <p class="rotulo">{t("investigacionDidactica", lang)}</p>
    <h1>{titulo}</h1>
    <p class="intro__texto">{t("investigacionLead", lang)}</p>
  </header>

  <div class="envoltorio seccion">
    <div class="seccion__principal">
      {cuerpo.trim() && <div class="cuerpo-pagina" set:html={cuerpo} data-pagefind-body />}

      {lineas.map((l) => (
        <section aria-labelledby={`linea-${l.id}`}>
          <h2 id={`linea-${l.id}`} class="seccion__h2">{l.titulo}</h2>
          <ListaArticulos lang={lang} articulos={l.lista.slice(0, 6)} nivel={3} vacio={l.vacio} />
          {l.lista.length > 0 && <a class="rotulo seccion__mas" href={l.href}>{l.mas}</a>}
        </section>
      ))}

      {conPublicaciones && (
        <section aria-labelledby="pub-titulo">
          <h2 id="pub-titulo" class="seccion__h2">{t("publicaciones", lang)}</h2>
          <a class="rotulo seccion__mas" href={ruta("publicaciones", lang)}>{t("todasPublicaciones", lang)}</a>
        </section>
      )}
    </div>

    <aside class="caja-seccion">
      <p class="rotulo">{t("enEstaSeccion", lang)}</p>
      <ul>
        <li><a href={ruta("avances", lang)}>{t("economiaPolitica", lang)} →</a></li>
        <li><a href={ruta("didactica", lang)}>{t("didactica", lang)} →</a></li>
        {conPublicaciones && <li><a href={ruta("publicaciones", lang)}>{t("publicacionesFlecha", lang)}</a></li>}
        <li><a href={`${ruta("recursos", lang)}?area=investigacion`}>{t("datosMateriales", lang)}</a></li>
      </ul>
    </aside>
  </div>
</Base>

<style>
  .intro {
    max-width: calc(760px + 2 * var(--margen));
    margin: 0 auto;
    padding: 1.9rem var(--margen) 1.5rem;
  }
  .intro h1 { font-size: clamp(2.1rem, 4vw, 2.6rem); margin: 1.1rem 0 1.1rem; }
  .intro__texto { font-size: 1.25rem; line-height: 1.6; }

  .seccion {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 2.4rem;
    padding-top: 1.25rem;
    padding-bottom: 2.3rem;
    position: relative;
  }
  .seccion::before {
    content: ""; position: absolute; top: 0; left: var(--margen); right: var(--margen);
    border-top: 1px solid var(--grafito);
  }
  .seccion__principal { min-width: 0; max-width: 760px; }
  .seccion__h2 { font-size: 2.1rem; margin: 2.2rem 0 0.4rem; }
  .seccion__mas { display: inline-block; text-decoration: none; margin-top: 1rem; }
  .seccion__mas:hover { color: var(--rojo-texto); }

  .cuerpo-pagina { padding: 0 10px; }
  .cuerpo-pagina :global(p) { max-width: 68ch; line-height: 1.75; margin: 0 0 1.2rem; }
  .cuerpo-pagina :global(h2) { font-size: 1.65rem; margin: 2.2rem 0 1rem; }

  .caja-seccion {
    align-self: start;
    background: var(--blanco);
    border-top: 2px solid var(--grafito);
    padding: 1.4rem 1.4rem 1.6rem;
    margin-top: 1.25rem;
  }
  .caja-seccion h2 { font-size: 2.1rem; margin: 1rem 0 1.2rem; }
  .caja-seccion > p:not(.rotulo) { line-height: 1.55; }
  .caja-seccion ul { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: 1.1rem; }
  .caja-seccion li a {
    text-decoration: none;
    border-bottom: 1px solid var(--rojo);
    padding-bottom: 0.1rem;
  }
  .caja-seccion li a:hover { color: var(--rojo-texto); }

  @media (max-width: 999px) {
    .seccion { grid-template-columns: minmax(0, 1fr); }
    .caja-seccion { max-width: 560px; }
  }
  @media (max-width: 759px) {
    .intro__texto { font-size: 1.05rem; }
    .seccion__h2 { font-size: 1.6rem; }
    .caja-seccion h2 { font-size: 1.6rem; }
    .cuerpo-pagina { padding: 0; }
  }
</style>
